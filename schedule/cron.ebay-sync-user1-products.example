# em-tools — eBay US crawl docs (data ES) -> ebay_us_products (primary ES)
#
# Migration window (2026-11): BOTH source indices are scanned so the target
# keeps the old and the new documents side by side —
#   user1_ebay_products  -> _id=<item id>,      source=Ebay_US   (legacy)
#   user1_us_products    -> _id=ebay_us_<item>, source=ebay_us   (merged US)
#
# Production (c1002us / 35.202.167.107): hourly, last 2h of source `date`.
#
# Requires .env in the repo with:
#   ELASTICSEARCH_URL='http://user:pw@…'
#   DATA_ELASTICSEARCH_URL='http://user:pw@…'
#   EBAY_PRODUCT_SYNC_SINCE_HOURS=2   # optional default; CLI --since-hours overrides
#
# Install on VPS:
#   chmod +x /home/Admin/src/em-tools/scripts/ebay-sync-user1-products.sh
#   sudo cp schedule/cron.ebay-sync-user1-products.example /etc/cron.d/em-tools-ebay-products-sync
#   sudo chmod 644 /etc/cron.d/em-tools-ebay-products-sync
#   sudo mkdir -p /home/Admin/src/em-tools/log
#   sudo systemctl reload cron

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=""

# Every hour at :25 UTC — sync docs updated in the last 2 hours (overlap with prior run).
25 * * * *  Admin  EM_TOOLS_BUNDLE=/home/Admin/.rbenv/shims/bundle /home/Admin/src/em-tools/scripts/ebay-sync-user1-products.sh --source-index user1_ebay_products,user1_us_products --source ebay_us,Ebay_US --since-hours 2 >> /home/Admin/src/em-tools/log/ebay-sync-user1-products.log 2>&1
